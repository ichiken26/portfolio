---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | KOKAGE CMS</title>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  html,body{margin:0;min-height:100%;background:#f7f8f4}
</style>
