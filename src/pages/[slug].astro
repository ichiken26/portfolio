---
import Layout from "../layouts/Layout.astro";
import { api } from "../lib/api";
import { renderSafeMarkdown } from "../lib/markdown";
import type { CustomPage } from "../lib/types";

const slug = Astro.params.slug ?? "";
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) return new Response("Not Found", { status: 404 });
let page: CustomPage;
try { page = await api<CustomPage>(`/pages/${slug}`); } catch { return new Response("Not Found", { status: 404 }); }
const html = renderSafeMarkdown(page.body);
---
<Layout title={`${page.title} | KOKAGE`} description={page.description}>
  <main>
    <header class="custom-hero"><h1 class="page-title">{page.title}</h1>{page.description && <p class="lead">{page.description}</p>}</header>
    <article class="markdown-body" set:html={html} />
  </main>
</Layout>
<style>
  .custom-hero,.markdown-body{padding:28px;border:1px solid var(--line);border-radius:8px;background:var(--surface);box-shadow:var(--shadow)}
  .markdown-body{margin-top:22px}.markdown-body :global(h2){margin:0 0 14px;font-size:24px}.markdown-body :global(h3){margin:28px 0 12px;font-size:18px}.markdown-body :global(p),.markdown-body :global(li){color:var(--muted);line-height:1.85}.markdown-body :global(a){color:var(--accent-strong);font-weight:700}.markdown-body :global(pre){overflow-x:auto;padding:18px;border:1px solid var(--line);border-radius:8px;background:#f4f7f3}
</style>
