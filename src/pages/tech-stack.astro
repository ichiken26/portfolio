---
import TechStackCard from "../components/TechStackCard.tsx";import {techStacks} from "../data/portfolio";import Layout from "../layouts/Layout.astro";import {publicContent} from "../lib/api";import type {TechData} from "../lib/types";
let categories:TechData["categories"]=[...new Set(techStacks.map(t=>t.category))].map((name,i)=>({id:String(i),name,items:techStacks.filter(t=>t.category===name).map((t,j)=>({id:`${i}-${j}`,name:t.name,level:t.level,tags:t.tags}))}));try{categories=(await publicContent<TechData>("tech-stack")).data.categories}catch{}
---
<Layout title="Tech Stack | KOKAGE Portfolio"><main><section class="page-head"><p class="eyebrow">Tech Stack</p><h1 class="page-title">制作で使える技術スタック</h1></section>{categories.map(c=><section class="stack-section"><h2 class="section-title">{c.name}</h2><div class="card-grid">{c.items.map(t=><TechStackCard tech={{...t,category:c.name,level:t.level as never}}/>)}</div></section>)}</main></Layout><style>.page-head{padding:44px 0 34px}.stack-section{padding-top:34px}</style>
