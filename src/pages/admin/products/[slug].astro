---
import AdminShell from "../../../components/admin/AdminShell.astro";
import { AdminApp } from "../../../components/admin/AdminApp";
const slug = Astro.params.slug ?? "";
if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) return Astro.redirect("/admin/products/");
const title = `Product: ${slug}`;
---
<AdminShell title={title}><AdminApp view="product" slug={slug} title={title} client:only="react" /></AdminShell>
