---
import Layout from "../../layouts/Layout.astro";import {api} from "../../lib/api";import {renderSafeMarkdown} from "../../lib/markdown";import type {Product} from "../../lib/types";
const slug=Astro.params.slug??"";if(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug))return Astro.redirect("/products/");let product:Product;try{product=await api<Product>(`/products/${slug}`)}catch{return new Response("Not Found",{status:404})}const html=renderSafeMarkdown(product.body);
---
<Layout title={`${product.title} | Products`} description={product.summary}><main><a class="back-link" href="/products/">制作物一覧へ戻る</a><section class="detail-hero"><div><p class="eyebrow">{product.type}</p><h1 class="page-title">{product.title}</h1><p class="lead">{product.summary}</p><div class="status-row"><span>{product.status}</span>{product.tags.map(t=><span>{t}</span>)}</div></div><div class="detail-art"><img src={product.imagePath} alt={product.title}/></div></section><div class="links">{product.liveUrl&&<a href={product.liveUrl} target="_blank" rel="noreferrer noopener">公開サイト</a>}{product.githubUrls.map((url,i)=><a href={url} target="_blank" rel="noreferrer noopener">GitHub {i+1}</a>)}</div><article class="markdown-body" set:html={html}/></main></Layout>
<style>.back-link,.links a{display:inline-flex;margin:18px 10px 28px 0;color:var(--accent-strong);font-weight:800;text-decoration:none}.detail-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,380px);gap:36px;align-items:center;padding:38px;border:1px solid var(--line);border-radius:8px;background:var(--surface);box-shadow:var(--shadow)}.detail-art{aspect-ratio:1;border:3px solid var(--ink);border-radius:8px;overflow:hidden}.detail-art img{width:100%;height:100%;object-fit:cover}.status-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.status-row span{padding:8px 12px;border-radius:999px;background:var(--surface-muted);font-weight:800}.markdown-body{padding:28px;border:1px solid var(--line);border-radius:8px;background:var(--surface);box-shadow:var(--shadow)}@media(max-width:760px){.detail-hero{grid-template-columns:1fr;padding:22px}}</style>
