---
import Layout from "../layouts/Layout.astro"; import { publicContent } from "../lib/api"; import type { AboutData } from "../lib/types";
const fallback:AboutData={overview:"フロントエンド、バックエンド、公開基盤、デスクトップアプリまで、目的に合わせた技術選定や設計が可能です。",blocks:[]};
let content=fallback;let degraded=false;try{content=(await publicContent<AboutData>("about")).data}catch{degraded=true}
---
<Layout title="About | KOKAGE Portfolio" description="自己紹介と制作領域のページです。"><main><section class="intro"><p class="eyebrow">自己紹介</p><h1 class="page-title">About</h1><p class="lead">{content.overview}</p>{degraded&&<p class="notice">最新コンテンツを取得できないため、保存済みの概要を表示しています。</p>}</section><section class="profile-layout">{content.blocks.map(block=><article class="profile-panel"><h2>{block.title}</h2>{block.type==="text"&&<p>{block.text}</p>}{block.type==="list"&&<ul>{block.items.map(item=><li>{item}</li>)}</ul>}{block.type==="links"&&<ul>{block.items.map(item=><li><a href={item.url} target="_blank" rel="noreferrer noopener">{item.label}</a></li>)}</ul>}{block.type==="table"&&<table><tbody>{block.rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table>}</article>)}</section></main></Layout>
<style>.intro{padding:44px 0 28px}.profile-layout{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:28px}.profile-panel{padding:26px;border:1px solid var(--line);border-radius:8px;background:var(--surface);box-shadow:var(--shadow)}h2{margin:0 0 14px}p,li,td,th{color:var(--muted);line-height:1.85}ul{display:grid;gap:10px;padding-left:1.2em}.profile-panel a{color:var(--accent-strong);font-weight:700}table{width:100%;border-collapse:collapse}th,td{padding:9px;border:1px solid var(--line);text-align:left}.notice{font-size:13px}@media(max-width:800px){.profile-layout{grid-template-columns:1fr}}</style>
